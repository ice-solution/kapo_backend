    "/api/reports/{id}": {
      "get": {
        "tags": ["報告管理"],
        "summary": "生成客戶指紋分析報告",
        "description": "根據客戶檔案 ID 生成 PDF 格式的指紋分析報告",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "客戶檔案 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功生成並返回 PDF 報告",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "description": "檔案下載標頭",
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=\"client-report-張三-1234567890.pdf\""
                }
              }
            }
          },
          "401": {
            "description": "未授權，請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "無權存取此客戶檔案",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "客戶檔案未找到",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "伺服器錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/upload/upload": {
      "post": {
        "tags": ["檔案上傳"],
        "summary": "上傳圖片",
        "description": "上傳圖片檔案到伺服器",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "要上傳的圖片檔案"
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上傳成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "圖片上傳成功"
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "fieldname": {
                          "type": "string",
                          "example": "image"
                        },
                        "originalname": {
                          "type": "string",
                          "example": "fingerprint.jpg"
                        },
                        "encoding": {
                          "type": "string",
                          "example": "7bit"
                        },
                        "mimetype": {
                          "type": "string",
                          "example": "image/jpeg"
                        },
                        "destination": {
                          "type": "string",
                          "example": "uploads/"
                        },
                        "filename": {
                          "type": "string",
                          "example": "1703123456789.jpg"
                        },
                        "path": {
                          "type": "string",
                          "example": "uploads/1703123456789.jpg"
                        },
                        "size": {
                          "type": "number",
                          "example": 1024
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未上傳圖片",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "伺服器錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
